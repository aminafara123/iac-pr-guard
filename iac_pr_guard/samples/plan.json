{
  "format_version": "1.2",
  "terraform_version": "1.7.0",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_s3_bucket.data",
          "type": "aws_s3_bucket",
          "name": "data",
          "values": {
            "bucket": "amin-demo-public-data",
            "acl": "public-read"
          }
        },
        {
          "address": "aws_db_instance.db",
          "type": "aws_db_instance",
          "name": "db",
          "values": {
            "engine": "mysql",
            "instance_class": "db.t3.micro",
            "storage_encrypted": false,
            "publicly_accessible": true
          }
        }
      ]
    }
  }
}
